# ============================================================
# CET-AI-Reader 环境变量模板
# 用法：复制为 .env 后按需修改
#   macOS / Linux : cp .env.example .env
#   Windows       : copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库
# ============================================================

# OpenAI 兼容接口基地址（请求路径自动补齐 /chat/completions）
VITE_API_BASE_URL=https://gs.neisvip.com:2300/v1

# API Key：留空则启动后可在前端「设置」面板手动填写，并保存在浏览器本地
VITE_API_KEY=your_api_key_here

# 模型名称
VITE_MODEL_NAME=Qwen/Qwen3.8-Flash-Next-Uncensored

# 采样温度（可选，默认 0.3）
VITE_API_TEMPERATURE=0.3
