{
  "name": "cet-ai-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "英语四六级真题精读与 AI 解析 · 本地 Web 阅读应用",
  "scripts": {
    "start": "node scripts/fetch-and-parse-exams.js && vite",
    "dev": "vite",
